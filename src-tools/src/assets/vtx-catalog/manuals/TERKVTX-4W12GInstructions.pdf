               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Typeï¼š Input voltageï¼š Output voltageï¼š Video Transmission Protoco</photoshop:LayerName>
                  <photoshop:LayerText>Typeï¼š Input voltageï¼š Output voltageï¼š Video Transmission Protocolï¼š Frequency bandï¼š Channel customerï¼š Modulation typeï¼š Frequency controlï¼š Frequency Stabilityï¼š Frequency precisionï¼š S/N (FoÂ±3MHz)ï¼š Antenna Portï¼š Video input levelï¼š Operating Temperatureï¼š Control Protocolï¼š Weightï¼š Profile dimensionï¼š Channel Frequencyï¼š </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>TERK DC+7V~30V DC+5V IRC TRAMP 1080~1360MHz  16 FM PLL Â±100KHz </photoshop:LayerName>
                  <photoshop:LayerText>TERK DC+7V~30V DC+5V IRC TRAMP 1080~1360MHz  16 FM PLL Â±100KHz (TyP.) Â±200KHz (TyP.) &gt;55dBc SMA 50 Ohms 1VÂ±0.2Vp-p type -10â„ƒ~+60â„ƒ IRC Approx:40g 48mm(L)*32mm(W)*19mm(H) A:1080/1120/1160/1200/1240/1280/1320/1360MHz B:1080/1120/1160/1200/1258/1280/1320/1360MHz</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Basic Settings</photoshop:LayerName>
                  <photoshop:LayerText>Basic Settings</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>1.Open the VTX settings, click "Load from File" to select and i</photoshop:LayerName>
                  <photoshop:LayerText>1.Open the VTX settings, click "Load from File" to select and import the  corresponding VTX table, then save the configuration.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>2.Access the port interface, enable the "Peripheral" â†’ "IRCTRAM</photoshop:LayerName>
                  <photoshop:LayerText>2.Access the port interface, enable the "Peripheral" â†’ "IRCTRAMP" function for the  corresponding UART port.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Use the drop-down menu to select  the frequency band</photoshop:LayerName>
                  <photoshop:LayerText>Use the drop-down menu to select  the frequency band</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Use the drop-down menu to select  the channel</photoshop:LayerName>
                  <photoshop:LayerText>Use the drop-down menu to select  the channel</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Use the drop-down menu to select  the power output</photoshop:LayerName>
                  <photoshop:LayerText>Use the drop-down menu to select  the power output</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>You can increase the number of power levels here;  the default </photoshop:LayerName>
                  <photoshop:LayerText>You can increase the number of power levels here;  the default is 5 levels</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>3.Navigate to the "Video Transmission (VTX)" page and configure</photoshop:LayerName>
                  <photoshop:LayerText>3.Navigate to the "Video Transmission (VTX)" page and configure the  following settings.</photoshop:LayerText>
