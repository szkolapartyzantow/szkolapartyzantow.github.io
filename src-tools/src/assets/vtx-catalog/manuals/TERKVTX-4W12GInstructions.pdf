               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>POWER Buttonï¼š The green light indicates power levels. Short pre</photoshop:LayerName>
                  <photoshop:LayerText>POWER Buttonï¼š The green light indicates power levels. Short press to cycle through  power settings. The number of blinks corresponds to the power level:  1 blink for 25mW, 2 blinks for 400mW, 3 blinks for 600mW, 4 blinks for  1.6W, and 5 blinks for 3.0W. Long press for 2 seconds to switch to PIT  mode, which is indicated by a solid light.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Band/CH Buttonï¼š</photoshop:LayerName>
                  <photoshop:LayerText>Band/CH Buttonï¼š</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>The red light indicates the frequency group. Long press for 2 s</photoshop:LayerName>
                  <photoshop:LayerText>The red light indicates the frequency group. Long press for 2 seconds  to switch between frequency groups.  The number of blinks indicates the current frequency group: 1 blink for group A,  2 blinks for group B, 3 blinks for group E, 4 blinks for group F, 5 blinks for group R,  6 blinks for group L, and 7 blinks for group X. The blue light indicates the frequency point. Short press to cycle  through frequency points CH1 to CH8.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Button Descriptions</photoshop:LayerName>
                  <photoshop:LayerText>Button Descriptions</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>WARNING Be sure to plug in the antenna before powering up, or y</photoshop:LayerName>
                  <photoshop:LayerText>WARNING Be sure to plug in the antenna before powering up, or you will burn this product!!!</photoshop:LayerText>
               </rdf:li>
